/* Windows icon and version info. CMake fills in the @-variables from
   CLEANMODELS_QT_VERSION (CI passes the release tag) and builds the result
   into the Windows executable. Antivirus heuristics distrust a PE file with
   no metadata, so release builds must carry it. */
#include <windows.h>

IDI_ICON1	ICON	DISCARDABLE	"@CMQT_ICON@"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION @CMQT_VERSION_COMMAS@
	PRODUCTVERSION @CMQT_VERSION_COMMAS@
	FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#else
	FILEFLAGS 0x0L
#endif
	FILEOS VOS__WINDOWS32
	FILETYPE VFT_APP
	FILESUBTYPE 0x0L
	BEGIN
		BLOCK "StringFileInfo"
		BEGIN
			BLOCK "040904b0"
			BEGIN
				VALUE "CompanyName", "Clean Models Community\0"
				VALUE "FileDescription", "cleanmodels-qt - desktop GUI for the cleanmodels NWN:EE MDL tool\0"
				VALUE "FileVersion", "@CLEANMODELS_QT_VERSION@\0"
				VALUE "LegalCopyright", "Copyright (c) 2020-2026 James Greenhalgh. MIT License.\0"
				VALUE "OriginalFilename", "cleanmodels-qt.exe\0"
				VALUE "ProductName", "cleanmodels-qt\0"
				VALUE "ProductVersion", "@CLEANMODELS_QT_VERSION@\0"
			END
		END
		BLOCK "VarFileInfo"
		BEGIN
			VALUE "Translation", 0x0409, 1200
		END
	END
